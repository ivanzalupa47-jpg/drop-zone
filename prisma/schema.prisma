generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rarity {
  MIL_SPEC
  RESTRICTED
  CLASSIFIED
  COVERT
  SPECIAL_GOLD
}

enum WeaponKind {
  RIFLE
  SNIPER
  PISTOL
  SMG
  KNIFE
  GLOVES
}

enum InventoryStatus {
  IN_INVENTORY
  SOLD_DEMO
  UPGRADED
}

model User {
  id                 String              @id @default(cuid())
  username           String              @unique
  avatarSeed         String              @default("agent-01")
  demoBalance        Int                 @default(5000)
  casesOpened        Int                 @default(0)
  upgradesTried      Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           DemoSession[]
  inventoryItems     InventoryItem[]
  dropLogs           DropLog[]
  upgradeLogs        UpgradeLog[]
  idempotencyRecords IdempotencyRecord[]
}

model DemoSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IdempotencyRecord {
  id           String   @id @default(cuid())
  userId       String
  key          String
  action       String
  statusCode   Int
  responseJson String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Case {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  subtitle    String
  category    String
  demoPrice   Int
  accentColor String     @default("#F59E0B")
  badge       String?
  isFeatured  Boolean    @default(false)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       CaseItem[]
  dropLogs    DropLog[]
}

model Skin {
  id             String          @id @default(cuid())
  slug           String          @unique
  weapon         String
  skinName       String
  kind           WeaponKind
  rarity         Rarity
  demoValue      Int
  wearLabel      String          @default("Factory New")
  accentHex      String
  createdAt      DateTime        @default(now())
  caseItems      CaseItem[]
  inventoryItems InventoryItem[]
  dropLogs       DropLog[]
}

model CaseItem {
  id         String @id @default(cuid())
  caseId     String
  skinId     String
  dropChance Float

  caseBox Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  skin    Skin @relation(fields: [skinId], references: [id], onDelete: Cascade)

  @@unique([caseId, skinId])
}

model InventoryItem {
  id         String          @id @default(cuid())
  userId     String
  skinId     String
  floatValue Float           @default(0.0342)
  status     InventoryStatus @default(IN_INVENTORY)
  source     String          @default("CASE")
  caseTitle  String?
  obtainedAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skin Skin @relation(fields: [skinId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model DropLog {
  id        String   @id @default(cuid())
  userId    String
  caseId    String
  skinId    String
  rollSeed  String
  createdAt DateTime @default(now())

  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseBox Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  skin    Skin @relation(fields: [skinId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model UpgradeLog {
  id          String   @id @default(cuid())
  userId      String
  sourceValue Int
  targetValue Int
  chance      Float
  roll        Float
  succeeded   Boolean
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
