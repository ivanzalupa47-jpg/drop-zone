# PostgreSQL connection string (supports external PostgreSQL or local sandbox PGlite on 127.0.0.1:5432)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable"

# Demo mode disables real monetary operations and runs strictly with virtual DZ credits
DEMO_MODE="true"
NEXT_PUBLIC_DEMO_MODE="true"
NEXT_PUBLIC_APP_NAME="DROP ZONE"

# Secret used to HMAC-sign HttpOnly demo session cookies
SESSION_SECRET="dropzone-demo-only-hmac-secret-change-in-prod"
